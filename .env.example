# Copy to .env and fill in. Runs without any keys: the PayPal simulator, the offline rule engine (no AI model) and
# browser speech recognition. Everything simulated is labelled in the UI.

# ---------- PayPal ----------
# simulator = keyless, in-process stub that follows the documented shapes (labelled SIMULATED everywhere)
# sandbox   = the real PayPal sandbox; needs the two values below. Missing keys is an error, never a fallback.
# Live is not supported.
PAYPAL_MODE=simulator
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you register in the developer dashboard. Empty = webhooks answer 503 and Star uses status checks.
PAYPAL_WEBHOOK_ID=
# Sandbox personal accounts for the family, e.g. {"p_daughter":"anna@personal.example","p_son":"david@personal.example"}
PAYPAL_SANDBOX_RECEIVERS=
PAYPAL_TIMEOUT=20
# Where PayPal sends the buyer back to, e.g. https://star.example. Empty = taken from the request (Render sets its own).
PUBLIC_BASE_URL=
# Simulator only: how long a payout stays "processing"
PAYPAL_SIM_SETTLE_SECONDS=1.5
# An unresolved outcome older than this many minutes raises a family alert
PAYPAL_UNKNOWN_ALERT_MIN=10

# ---------- The wallet ----------
WALLET_CURRENCY=USD
# Star can't see a PayPal balance: this is the limit she and her family set
WALLET_ALLOWANCE=1500
# US is the only table entry so far.
SCAM_HOTLINE_COUNTRY=US
# The late-night rule uses the zone her browser reports (a checked zone name, never an hour); this is the fallback.
CUSTOMER_TIMEZONE=America/New_York
# A first payment to someone new above this needs the family guardian's approval
GUARDIAN_THRESHOLD=300

# ---------- Model (any OpenAI-compatible API) ----------
# offline = built-in rule engine, NOT an AI model, and the UI says so; openai_compat = call the API below
LLM_PROVIDER=offline
LLM_BASE_URL=
LLM_API_KEY=
# Use a model name your provider actually offers; it must support Function Calling (tools)
LLM_MODEL=
# Model for the scam assessment (a separate second call); empty = same as the main model
LLM_JUDGE_MODEL=
# Model for the independent verifier (second engine of the dual-engine audit). Empty = the judge model, else the
# main model. A DIFFERENT model makes the two engines more independent.
LLM_VERIFIER_MODEL=
# model: the model writes multi-step plans, code computes the amounts; rules: regex splitter only
PLANNER=model
LLM_TIMEOUT=30
# Max tokens per model call, so one runaway answer can't stall a turn
LLM_MAX_TOKENS=600
# For money requests the first call asks the API to force a tool call (tool_choice=required). If one takes longer
# than this many seconds, forcing is switched off for this server (the harness nudge + fallback still apply).
LLM_REQUIRED_SLOW_SECONDS=8
# off = disable Qwen's hidden thinking step (much faster). Only for Qwen / vLLM-style servers; leave empty otherwise
LLM_THINKING=

# ---------- Optional server speech recognition ----------
# browser = the browser's own recognition, no recordings kept (default)
# openai_compat = POST {ASR_BASE_URL}/audio/transcriptions; recordings are kept and linked to the signed card
ASR_PROVIDER=browser
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# ---------- Agent and risk rules (example values) ----------
AGENT_MAX_STEPS=6
RULE_HARD_LIMIT=5000
RULE_HIGH_THRESHOLD=500
RULE_VELOCITY_MAX=5
RULE_VELOCITY_WINDOW_MIN=10
# Cooling-off threshold for accounts on Standard protection (Enhanced uses RULE_HIGH_THRESHOLD)
RULE_HIGH_THRESHOLD_STANDARD=1200
# Lowering protection (Enhanced -> Standard) is signed and only takes effect after this many seconds.
# 86400 (24 h) is realistic; use e.g. 30 to show it in a demo.
PROTECTION_LOWER_DELAY=86400
# Cooling-off period in seconds: 20 for the demo, e.g. 600 in production
RULE_COOLDOWN_SECONDS=20
# Required with PUBLIC_DEMO=1 or outside the simulator: the server won't start with this placeholder.
SIGNING_SECRET=change-me-to-a-long-random-string
# How many of your own proxies sit in front of the server and append to X-Forwarded-For (0 = ignore that header).
TRUSTED_PROXY_HOPS=0

# ---------- Payment authorization ----------
# Every payment is signed on the user's device: with a passkey (the device's own fingerprint / face check) when the
# browser has one, otherwise with a non-extractable browser key. The execution gateway re-verifies it.
# device_key = the above (default, use this for the demo)
# mock       = also accept the old "demo-fingerprint" string (quick scripts only; the gateway then allows unsigned)
AUTH_MODE=device_key
# Websites the server answers to. Passkeys only work on localhost or HTTPS.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Persistent demo wallet (keep this on durable storage in a deployment).
LEDGER_PATH=data/ledger.sqlite3
